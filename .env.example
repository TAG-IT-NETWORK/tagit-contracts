# TAG IT Contracts — Environment Variables
# Copy to .env and fill in your values

FOUNDRY_DISABLE_NIGHTLY_WARNING=1

# Deployer private key (NEVER commit real keys)
PRIVATE_KEY=0x_YOUR_PRIVATE_KEY

# OP Sepolia
OP_SEPOLIA_RPC_URL=https://opt-sepolia.g.alchemy.com/v2/YOUR_KEY
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Arbitrum Sepolia
ARBITRUM_SEPOLIA_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/YOUR_KEY
ARBISCAN_API_KEY=YOUR_ARBISCAN_API_KEY

# Gnosis Safe multisig (3-of-5 on OP Sepolia)
# See tagit-governance/docs/multisig-spec.md for signer details
SAFE_ADDRESS=0xAaA33C556C9c97a5430D180A1f72e8cf0fe0354e
CHAIN_ID=11155420

# Signer addresses for DeploySafe.s.sol (set before deployment)
# SIGNER_1=0x_FOUNDER_ADDRESS
# SIGNER_2=0x_ENGINEERING_LEAD_ADDRESS
# SIGNER_3=0x_SECURITY_OFFICER_ADDRESS
# SIGNER_4=0x_OPERATIONS_LEAD_ADDRESS
# SIGNER_5=0x_COMMUNITY_REP_ADDRESS

# Agent Suite
TAGIT_ACCESS=0x0611FE60f6E37230bDaf04c5F2Ac2dc9012130a9
SAGE_WALLET=0xDb8ACD440Ef32a4D23AD685Dd64aC386b0d3d63F
SAGE_URI=ipfs://QmSageAgentMetadata
