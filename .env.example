# TAG IT Contracts — Environment Variables
# Copy to .env and fill in your values

FOUNDRY_DISABLE_NIGHTLY_WARNING=1

# Deployer private key (NEVER commit real keys)
PRIVATE_KEY=0x_YOUR_PRIVATE_KEY

# Base Sepolia (84532) — THE ONLY LIVE CHAIN.
# Both of these are referenced by foundry.toml but were absent from this file
# until 2026-08-01, so a fresh checkout could not deploy to or verify on the live
# chain. BASE_SEPOLIA_RPC_URL is also the fork-test RPC (test/fork/ForkBase.t.sol
# falls back to the public https://sepolia.base.org if unset).
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY
BASESCAN_API_KEY=YOUR_BASESCAN_API_KEY

# Base mainnet — not deployed. Set only when that changes.
BASE_MAINNET_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# Ethereum mainnet — fork testing only, no deployment.
ETH_MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Gnosis Safe multisig
SAFE_ADDRESS=0x_YOUR_SAFE_ADDRESS
CHAIN_ID=84532

# ARCHIVED CHAINS — OP Sepolia (11155420) and Arbitrum Sepolia (421614) were
# deprecated 2026-06-27 and carry "status": "archived" in
# deployment-addresses.json. Their RPC/verifier entries were removed from
# foundry.toml on 2026-08-01. Do not deploy to them.

# Agent Suite
TAGIT_ACCESS=0x0611FE60f6E37230bDaf04c5F2Ac2dc9012130a9
SAGE_WALLET=0xDb8ACD440Ef32a4D23AD685Dd64aC386b0d3d63F
SAGE_URI=ipfs://QmSageAgentMetadata
